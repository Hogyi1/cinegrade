<?xml version="1.0" encoding="UTF-8"?>
<!-- [AI-GENERATED] -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="editPanelRoot" fx:controller="hu.elte.ik.thesis.cinegrade.javafx.ui.editing.DevelopEditPanelController" prefWidth="350.0" minWidth="330.0" maxWidth="380.0"
      styleClass="sidebar-panel-right"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <!-- Histogram Section (Always visible at top of sidebar) -->
        <VBox styleClass="histogram-container">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label styleClass="clipping-badge-shadow" text="◀ SHADOWS"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label styleClass="clipping-badge-highlight" text="HIGHLIGHTS ▶"/>
                    </children>
                </HBox>
                <!-- The canvas is unmanaged and bound to this holder by the controller: it follows the panel width -->
                <StackPane fx:id="histogramHolder" minHeight="110.0" prefHeight="110.0" maxHeight="110.0" minWidth="0.0" styleClass="histogram-canvas">
                    <children>
                        <Canvas fx:id="histogramCanvas" managed="false"/>
                    </children>
                </StackPane>
                <Label fx:id="cameraExifLabel" alignment="CENTER" maxWidth="Infinity" styleClass="histogram-exif"/>
            </children>
        </VBox>

        <!-- Edit / Metadata switch -->
        <HBox alignment="CENTER" spacing="6.0" styleClass="panel-tab-bar">
            <children>
                <ToggleButton fx:id="editTabBtn" mnemonicParsing="false" styleClass="curve-channel-btn" text="Edit"/>
                <ToggleButton fx:id="metadataTabBtn" mnemonicParsing="false" styleClass="curve-channel-btn" text="Metadata"/>
            </children>
        </HBox>

        <!-- Edit tab: the EditPanes (Basic, Color Mixer, Detail & Effects), added by the controller -->
        <ScrollPane fx:id="editTab" fitToWidth="true" hbarPolicy="NEVER" styleClass="sidebar-scroll" VBox.vgrow="ALWAYS">
            <content>
                <!-- minWidth 0: fitToWidth then always sizes it to the viewport, a wider child can no longer scroll it sideways -->
                <VBox fx:id="panelsContainer" minWidth="0.0" spacing="1.0"/>
            </content>
        </ScrollPane>

        <!-- Metadata tab: one name | value row per field, added by the controller -->
        <ScrollPane fx:id="metadataTab" fitToWidth="true" hbarPolicy="NEVER" styleClass="sidebar-scroll" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="metadataTable" minWidth="0.0" styleClass="metadata-table"/>
            </content>
        </ScrollPane>
    </children>
</VBox>
