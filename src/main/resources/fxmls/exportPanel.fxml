                                            <children>
                                                <ToggleButton fx:id="lutSize17Btn" mnemonicParsing="false" styleClass="export-segment-btn" text="17" toggleGroup="$lutSizeGroup"/>
                                                <ToggleButton fx:id="lutSize33Btn" mnemonicParsing="false" selected="true" styleClass="export-segment-btn" text="33" toggleGroup="$lutSizeGroup"/>
                                                <ToggleButton fx:id="lutSize65Btn" mnemonicParsing="false" styleClass="export-segment-btn" text="65" toggleGroup="$lutSizeGroup"/>
                                            </children>
                                        </HBox>
                                        <Label styleClass="export-hint" text="33 suits most editors. 65 is more accurate but gives a larger file."/>
                                    </children>
                                </HBox>
                                <HBox styleClass="export-row">
                                    <children>
                                        <Label styleClass="export-row-label" text="Contents"/>
                                        <CheckBox fx:id="lutLookOnlyCheck" mnemonicParsing="false" selected="true" styleClass="export-check" text="Leave out exposure and white balance, so the look suits any photo"/>
                                    </children>
                                </HBox>
                                <HBox styleClass="export-row">
                                    <children>
                                        <Label styleClass="export-row-label" text="Save as"/>
                                        <TextField fx:id="lutDestinationField" editable="false" focusTraversable="false" promptText="Choose a .cube file" styleClass="export-input" HBox.hgrow="ALWAYS"/>
                                        <Button fx:id="browseLutBtn" mnemonicParsing="false" styleClass="export-btn-secondary" text="Browse"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </StackPane>

                <!-- The action, says what will happen -->
                <HBox styleClass="export-action-bar">
                    <children>
                        <Label fx:id="exportSummaryLabel" maxWidth="Infinity" styleClass="export-summary" text="Choose a folder to save to" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="startExportBtn" defaultButton="true" minWidth="-Infinity" mnemonicParsing="false" styleClass="export-btn-primary" text="Export 12 photos"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
