                                                <Label fx:id="scopeLastImportCount" mouseTransparent="true" styleClass="export-scope-count" text="0" StackPane.alignment="CENTER_RIGHT"/>
                                            </children>
                                        </StackPane>
                                        <StackPane>
                                            <children>
                                                <RadioButton fx:id="scopeAllRadio" maxWidth="Infinity" mnemonicParsing="false" styleClass="export-scope-option" text="Whole catalog" toggleGroup="$scopeRadioGroup"/>
                                                <Label fx:id="scopeAllCount" mouseTransparent="true" styleClass="export-scope-count" text="0" StackPane.alignment="CENTER_RIGHT"/>
                                            </children>
                                        </StackPane>
                                    </children>
                                </VBox>

                                <VBox spacing="14.0" styleClass="export-plate" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="export-plate-title" text="File settings"/>
                                        <HBox styleClass="export-row">
                                            <children>
                                                <Label styleClass="export-row-label" text="Format"/>
                                                <HBox maxWidth="-Infinity" styleClass="export-segment">
                                                    <children>
                                                        <ToggleButton fx:id="formatJpegBtn" mnemonicParsing="false" selected="true" styleClass="export-segment-btn" text="JPEG" toggleGroup="$formatGroup"/>
