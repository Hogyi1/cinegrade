                                                    </children>
                                                </HBox>
                                                <Label fx:id="bitDepthLabel" styleClass="export-hint" text="8-bit"/>
                                            </children>
                                        </HBox>
                                        <HBox fx:id="qualityRow" styleClass="export-row">
                                            <children>
