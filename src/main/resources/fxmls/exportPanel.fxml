                                        </StackPane>
                                        <StackPane>
                                            <children>
                                                <RadioButton fx:id="scopeSelectedRadio" maxWidth="Infinity" mnemonicParsing="false" selected="true" styleClass="export-scope-option" text="Selected" toggleGroup="$scopeRadioGroup"/>
                                                <Label fx:id="scopeSelectedCount" mouseTransparent="true" styleClass="export-scope-count" text="0" StackPane.alignment="CENTER_RIGHT"/>
                                            </children>
