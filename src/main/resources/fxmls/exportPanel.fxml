                                        <Label styleClass="export-plate-title" text="Photos to export"/>
                                        <StackPane>
                                            <children>
                                                <RadioButton fx:id="scopeCurrentRadio" maxWidth="Infinity" mnemonicParsing="false" styleClass="export-scope-option" text="Current photo" toggleGroup="$scopeRadioGroup"/>
