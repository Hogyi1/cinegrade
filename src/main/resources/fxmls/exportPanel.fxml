                                        <StackPane>
                                            <children>
                                                <RadioButton fx:id="scopeVisibleRadio" maxWidth="Infinity" mnemonicParsing="false" styleClass="export-scope-option" text="Matching the filters" toggleGroup="$scopeRadioGroup"/>
