<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Root is the CommentEditor itself; styles in components.css (.comment-editor) -->
<fx:root type="javafx.scene.layout.VBox" styleClass="comment-editor" spacing="10.0"
         prefWidth="300.0" maxWidth="300.0" minWidth="300.0"
         xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="titleLabel" styleClass="comment-editor-title" text="Comment"/>
        <TextArea fx:id="commentArea" prefRowCount="4" promptText="Write a note about this photo" styleClass="comment-editor-area" wrapText="true"/>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <children>
                <Label styleClass="comment-editor-hint" text="Ctrl+Enter to save"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="cancelButton" mnemonicParsing="false" styleClass="comment-editor-cancel" text="Cancel"/>
                <Button fx:id="saveButton" mnemonicParsing="false" styleClass="comment-editor-save" text="Save"/>
            </children>
        </HBox>
    </children>
</fx:root>
